# Card Room API (server/)
PORT=8787
HOST=127.0.0.1
# Production: HOST=0.0.0.0 and include your Pages origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bryanxbt.github.io
SESSION_SECRET=dev-only-change-me

# mock | arch-localnet | arch-testnet | arch-mainnet
PAYMENTS_MODE=mock

# Postgres (optional — memory ledger used when unset)
# DATABASE_URL=postgres://coinup:coinup@127.0.0.1:5433/coinup_card_room

# Redis optional (empty = in-process fanout)
# REDIS_URL=

# Local Arch stack (archie start-local-devnet.sh)
ARCH_RPC_URL=http://127.0.0.1:9002
TITAN_URL=http://127.0.0.1:8080
BITCOIN_RPC_URL=http://127.0.0.1:18443
ARCHIE_ROOT=/Volumes/BryanXBTLacie/archie
