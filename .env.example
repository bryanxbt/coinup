# Web (Next static / dev)
# Local: leave unset → http://127.0.0.1:8787
# Production Pages: set via GH secret CR_API_URL → card-room-runtime.json
NEXT_PUBLIC_CR_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CR_WS_URL=ws://127.0.0.1:8787/ws
NEXT_PUBLIC_CARD_ROOM_ENABLED=true
NEXT_PUBLIC_PAYMENTS_MODE=mock
NEXT_PUBLIC_CR_FUNDS_BANNER=true
